{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@bep-nha-minh/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@bep-nha-minh/shared/*": [
        "./packages/shared/src/*"
      ],
      "@bep-nha-minh/api": [
        "./apps/api/src/index.ts"
      ],
      "@bep-nha-minh/api/*": [
        "./apps/api/src/*"
      ],
      "@/*": [
        "./apps/web/src/*"
      ]
    }
  },
  "include": [
    "apps/web/next-env.d.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/.next/types/**/*.ts",
    "apps/web/.next/dev/types/**/*.ts",
    "apps/api/src/**/*.ts",
    "packages/shared/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
