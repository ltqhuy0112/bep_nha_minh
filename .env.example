NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ORDERING_ENABLED=false
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
COMMERCE_API_URL=http://127.0.0.1:3001
API_HOST=127.0.0.1
API_PORT=3001
PUBLIC_WEB_URL=http://localhost:3000
# Customer auth is disabled until its security/configuration gates are approved.
CUSTOMER_AUTH_ENABLED=false
# Local test policy only; leave empty to keep the gate closed.
CUSTOMER_AUTH_SESSION_POLICY=
# Local policy defaults, not approved production thresholds. Shared across replicas.
CUSTOMER_AUTH_RATE_LIMIT=10
CUSTOMER_AUTH_RATE_WINDOW_SECONDS=60
# Independent base64-encoded 32-byte HMAC key, identical on all API instances.
# Required whenever customer auth is enabled. Do not reuse the email key.
CUSTOMER_AUTH_RATE_LIMIT_KEY=
# OAuth providers remain disabled until dev credentials and exact callbacks are configured.
# Separate base64 32-byte encryption key shared by API instances; never NEXT_PUBLIC.
CUSTOMER_AUTH_OAUTH_KEY=
# JSON array of exact callbacks. No wildcard, return URL or query string.
CUSTOMER_AUTH_OAUTH_REDIRECT_URIS=["http://localhost:3000/api/customer-auth/oauth/facebook/callback", "http://localhost:3000/api/customer-auth/oauth/google/callback"]
CUSTOMER_AUTH_GOOGLE_ENABLED=false
CUSTOMER_AUTH_GOOGLE_CLIENT_ID=
CUSTOMER_AUTH_GOOGLE_CLIENT_SECRET=
CUSTOMER_AUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/customer-auth/oauth/google/callback
CUSTOMER_AUTH_FACEBOOK_ENABLED=false
CUSTOMER_AUTH_FACEBOOK_CLIENT_ID=
CUSTOMER_AUTH_FACEBOOK_CLIENT_SECRET=
CUSTOMER_AUTH_FACEBOOK_REDIRECT_URI=http://localhost:3000/api/customer-auth/oauth/facebook/callback
# Set to the version supported by the configured Meta app; no implicit version.
CUSTOMER_AUTH_FACEBOOK_GRAPH_VERSION=
# Base64-encoded 32-byte key; backend only. Never commit a real value.
CUSTOMER_AUTH_EMAIL_KEY=
# No production email provider selected or enabled.
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
CUSTOMER_AUTH_EMAIL_DISPATCH_ENABLED=false
CUSTOMER_AUTH_EMAIL_BATCH_SIZE=20
CUSTOMER_AUTH_EMAIL_MAX_ATTEMPTS=5
CUSTOMER_AUTH_EMAIL_RETRY_BASE_SECONDS=60
CUSTOMER_AUTH_EMAIL_RETRY_CAP_SECONDS=3600
CUSTOMER_AUTH_EMAIL_LEASE_SECONDS=120
# Dispatcher operations: all values require an explicit local/deployment policy.
CUSTOMER_AUTH_EMAIL_WORKER_ID=auth-email-worker-local-1
CUSTOMER_AUTH_EMAIL_POLL_SECONDS=5
CUSTOMER_AUTH_EMAIL_FAILURE_BASE_SECONDS=5
CUSTOMER_AUTH_EMAIL_FAILURE_CAP_SECONDS=60
CUSTOMER_AUTH_EMAIL_FAILURE_MAX_CONSECUTIVE=5
CUSTOMER_AUTH_EMAIL_CLEANUP_BATCH_SIZE=100
CUSTOMER_AUTH_EMAIL_BACKLOG_WARNING_COUNT=20
CUSTOMER_AUTH_EMAIL_BACKLOG_URGENT_COUNT=100
CUSTOMER_AUTH_EMAIL_BACKLOG_WARNING_AGE_SECONDS=60
CUSTOMER_AUTH_EMAIL_BACKLOG_URGENT_AGE_SECONDS=300
CUSTOMER_AUTH_EMAIL_DISPATCHER_FAILURE_ALERT_THRESHOLD=3
AUTH_SECRET=replace-with-a-long-random-admin-auth-secret

DATABASE_URL=postgresql://bep_user:bep_password@localhost:5432/bep_nha_minh

POSTGRES_USER=bep_user
POSTGRES_PASSWORD=bep_password
POSTGRES_DB=bep_nha_minh

NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/bepnhaminh.sg
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61591894748199
NEXT_PUBLIC_TIKTOK_URL=
# admin@example.com
# Admin12345!@#
